{
  "manifest_version": 3,
  "name": "YouTube Feed Blocker",
  "version": "0.2.0",
  "description": "Hide YouTube Shorts, the home feed, Up next, autoplay and comments. Peeking at your feed takes a pause you choose.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YouTube Feed Blocker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_start",
      "css": [
        "src/content/hide-shorts.css",
        "src/content/overlay.css",
        "src/content/watch-page.css"
      ],
      "js": [
        "src/lib/defaults.js",
        "src/lib/storage.js",
        "src/lib/feed-budget.js",
        "src/lib/peek-session.js",
        "src/content/shorts-blocker.js",
        "src/content/watch-page.js",
        "src/content/reason-banner.js",
        "src/content/feed-widgets.js",
        "src/content/feed-replacer.js"
      ]
    }
  ]
}
